# ─── Provider ────────────────────────────────────────────────────────────────
# "mock"  -> fully self-contained synthetic market. No Kite needed. (default)
# "kite"  -> live Zerodha Kite Connect. Requires the credentials below.
PT_PROVIDER=mock
# Which broker serves PRICES. "mock" | "kite" | "replay" | "upstox" | "dhan".
# The last two are DATA ONLY — they place no orders, so naming one here without also naming an
# execution connection below means the session is paper.

# Which connection places the ORDERS. Two ways, and the first wins:
#   PT_EXECUTION_CONNECTION — the `scope` of a stored connection in `broker_connections`,
#                             owned by PT_OWNER_ID. Naming one that does not exist REFUSES;
#                             it never falls back, because that would trade through a
#                             credential you did not choose.
#   PT_EXECUTION_PROVIDER   — a broker name, credentialed from the environment. Empty (the
#                             default, and what production runs) means "the same connection
#                             that serves prices".
# PT_EXECUTION_CONNECTION=
# PT_EXECUTION_PROVIDER=

# Encrypts stored broker credentials (AES-256-GCM). 32 random bytes, base64. Generate with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# NOT optional if you store a connection: with no key, credentials are REFUSED rather than
# written in plaintext. Keep it out of the database and out of anything deploy.sh rsyncs —
# a key that travels with the database file is not encryption.
# PT_CREDENTIAL_KEY=


# Only used when PT_PROVIDER=kite. The mock provider ignores these.
KITE_API_KEY=
KITE_API_SECRET=

# ─── Telegram alerts (optional) ──────────────────────────────────────────────
# Leave blank to disable notifications. To enable: message @BotFather to create a
# bot and copy its token; message your new bot once, then open
#   https://api.telegram.org/bot<token>/getUpdates
# and copy the "chat":{"id":...} value.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Capital & risk ──────────────────────────────────────────────────────────
PT_INITIAL_CAPITAL=50000
PT_STOP_LOSS_PCT=0.30      # close if option premium falls 30% below entry
PT_TARGET_PCT=0.60         # close if option premium rises 60% above entry

# ─── Option picker ───────────────────────────────────────────────────────────
PT_TARGET_DELTA=0.50       # pick the contract whose |delta| is closest to this
PT_DELTA_BAND=0.15         # acceptable band around target (0.35 .. 0.65)
PT_MIN_OI=500              # liquidity floor: minimum open interest
PT_MAX_SPREAD_PCT=0.03     # liquidity floor: max bid-ask spread as % of premium

# ─── Strategy ────────────────────────────────────────────────────────────────
PT_INTERVAL=15minute       # 15minute or 30minute ONLY (strategy is tuned for these)
PT_EMA_LENGTH=50
PT_Z_LENGTH=50
PT_ENTRY_Z=1.0
PT_SLOPE_LOOKBACK=5

# ─── Mock demo clock ─────────────────────────────────────────────────────────
# Real seconds between simulated candle advances. Lower = faster demo.
PT_MOCK_TICK_SECONDS=3
PT_MOCK_SEED=7
PT_MOCK_HISTORY_DAYS=90

# ─── Research plane (frozen by default) ──────────────────────────────────────
# Master switch for the autonomous research plane (nightly research run, generated-
# strategy registration, /api/portfolio promotions/deploy API, Portfolio tab).
# Off (default) = dormant, cannot interfere with the engine. Set to 1 to revive.
# PT_RESEARCH_ENABLED=0

# ─── Misc ────────────────────────────────────────────────────────────────────
PT_RISK_FREE_RATE=0.065
# One execution database authority. Leave blank for the legacy local SQLite path.
# A production process must set this to PostgreSQL; do not put real credentials here.
# PT_PRODUCTION=1
# PT_DATABASE_URL=postgresql+psycopg://strategy_os:change-me@localhost:5432/strategy_os
PT_DB_PATH=paper_trader.db
# Private-plane authorities. Local development may omit these and use the separate
# SQLite paths. Production must set PostgreSQL URLs. When one database hosts all
# planes, give each URL an explicit, different search_path schema.
# PT_RESEARCH_DATABASE_URL=postgresql+psycopg://strategy_os:change-me@localhost:5432/strategy_os?options=-csearch_path%3Dresearch
# PT_LEDGER_DATABASE_URL=postgresql+psycopg://strategy_os:change-me@localhost:5432/strategy_os?options=-csearch_path%3Dledger
# PT_RESEARCH_DB_PATH=research.db
# PT_LEDGER_DB_PATH=app/ledger.db

# ─── API auth + CORS ─────────────────────────────────────────────────────────
# Blank = auth disabled (default; fine for localhost-only dev). Set this to require
# a bearer token on every REST/WS call except /api/health and the Kite OAuth
# redirect endpoints (/api/login, /api/session). Pair with VITE_PT_TOKEN in the
# frontend's .env so the app can still talk to the API.
# PT_API_TOKEN=
# Comma-separated browser origins allowed to call the API with credentials.
# PT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
