# python
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/

# data / secrets
*.db
*.db-wal
*.db-shm
backend/access_token.json
# local content-addressed candle store (~10 GB at the 10k×5 tier) — data, not source
backend/backtest_datasets/
backend/.env
backend/predrop-*.sql          # live-ledger recovery dumps — real trades, never commit
backend/*-ledger-*.sql

# local tooling scratch (spec-driven-dev progress, not source)
.superpowers/

# node / build
frontend/node_modules/
frontend/dist/
.playwright-mcp/

# build stamp — generated per-deploy by scripts/deploy.sh, read at boot by
# app/core/version.py, and stamped onto trades.build_sha. Never committed:
# it describes a deployment, not a revision.
backend/VERSION
*.db.lock
